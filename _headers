/assets/audio/*
  Content-Type: audio/mp4

/assets/derivative/*
  Content-Type: audio/mpeg

/assets/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=3600

/data/*
  Cache-Control: public, max-age=3600

/buttons/*
  Cache-Control: public, max-age=60
  X-Frame-Options: SAMEORIGIN
