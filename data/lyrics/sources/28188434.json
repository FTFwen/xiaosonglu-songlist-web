    },
    {
      "t": 33.25,
      "text": "【银】蝉声陪伴着行云流浪"
    },
    {
      "t": 37.37,
      "text": "回忆开始后安静遥望远方"
    },
    {
      "t": 41.27,
      "text": "荒草覆没的古井枯塘"
    },
    {
      "t": 45.25,
      "text": "匀散一缕过往"
    },
    {
      "t": 49.75,
      "text": "【云】晨曦惊扰了陌上新桑"
    },
    {
      "t": 53.6,
      "text": "风卷起庭前落花穿过回廊"
    },
    {
      "t": 57.6,
      "text": "浓墨追逐着情绪流淌"
    },
    {
      "t": 61.64,
      "text": "染我素衣白裳"
    },
    {
      "t": 67.54,
      "text": "【银】阳光微凉"
    },
    {
      "t": 69.31,
      "text": "【云】琴弦微凉"
    },
    {
      "t": 71.27,
      "text": "【合】风声疏狂 人间仓皇"
    },
    {
      "t": 75.22,
      "text": "【银】呼吸微凉"
    },
    {
      "t": 77.52,
      "text": "【云】心事微凉"
    },
    {
      "t": 79.34,
      "text": "【合】流年匆忙 对错何妨"
    },
    {
      "t": 84.09,
      "text": "【云】你在尘世中辗转了千百年"
    },
    {
      "t": 88.59,
      "text": "却只让我看你最后一眼"
    },
    {
      "t": 92.9,
      "text": "【银】火光描摹容颜燃尽了时间"
    },
    {
      "t": 96.85,
      "text": "别留我一人 孑然一身"
    },
    {
      "t": 101.14,
      "text": "凋零在梦境里面"
    },
    {
      "t": 122.05,
      "text": "【银】萤火虫愿将夏夜遗忘"
    },
    {
      "t": 125.68,
      "text": "如果终究要挥别这段时光"
    },
    {
      "t": 129.79,
      "text": "裙袂不经意沾了荷香"
    },
    {
      "t": 133.75,
      "text": "从此坠入尘网"
    },
    {
      "t": 138.24,
      "text": "【云】屐齿轻踩着烛焰摇晃"
    },
    {
      "t": 142.16,
      "text": "所有喧嚣沉默都描在画上"
    },
    {
      "t": 146.22,
      "text": "从惊蛰一路走到霜降"
    },
    {
      "t": 150.51,
      "text": "泪水凝成诗行"
    },
    {
      "t": 156.08,
      "text": "【云】灯花微凉"
    },
    {
      "t": 157.94,
      "text": "【银】笔锋微凉"
    },
    {
      "t": 159.82,
      "text": "【合】难绘虚妄 难解惆怅"
    },
    {
      "t": 163.75,
      "text": "【云】梦境微凉"
    },
    {
      "t": 166.35,
      "text": "【银】情节微凉"
    },
    {
      "t": 168.22,
      "text": "【合】迷离幻象 重叠忧伤"
    },
    {
      "t": 172.4,
      "text": "原来诀别是因为深藏眷恋"
    },
    {
      "t": 176.96,
      "text": "你用轮回换我枕边月圆"
    },
    {
      "t": 181.17,
      "text": "我愿记忆停止在枯瘦指尖"
    },
    {
      "t": 185.21,
      "text": "随繁花褪色 尘埃散落"
    },
    {
      "t": 189.46,
      "text": "渐渐地渐渐搁浅"
    },
    {
      "t": 194.06,
      "text": "【云】多年之后 我又梦到那天"
    },
    {
      "t": 201.41,
      "text": "【银】画面遥远 恍惚细雨绵绵"
    },
    {
      "t": 210.1,
      "text": "【合】如果来生太远寄不到诺言"
    },
    {
      "t": 214,
      "text": "不如学着放下许多执念"
    },
    {
      "t": 218.23,
      "text": "以这断句残篇向岁月吊唁"
    },
    {
      "t": 222.29,
      "text": "老去的当年 水色天边"
    },
    {
      "t": 226.53,
      "text": "有谁将悲欢收殓"
    },
    {
      "t": 230.59,
      "text": "【云】蝉声陪伴着行云流浪"
    },
    {
      "t": 234.78,
      "text": "回忆的远方"
    }
  ]
