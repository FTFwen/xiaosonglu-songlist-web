    {
      "t": 192.75,
      "text": "从那腐朽灰烬边角"
    },
    {
      "t": 194.81,
      "text": "鲜花盛开在一步之遥"
    },
    {
      "t": 197.3,
      "text": "赞美这纯洁光芒 生命荣耀"
    },
    {
      "t": 200.74,
      "text": "绝不会哀嚎"
    },
    {
      "t": 202.71,
      "text": "绝不要求饶"
    },
    {
      "t": 204.81,
      "text": "永远骄傲"
    },
    {
      "t": 215.81,
      "text": "「小女孩摆脱了魔女的纠缠」"
    },
    {
      "t": 218.96,
      "text": "「找回了失去的记忆」"
    },
    {
      "t": 221.81,
      "text": "「她想起了妈妈」"
    },
    {
      "t": 223.64,
      "text": "「想起了哥哥」"
