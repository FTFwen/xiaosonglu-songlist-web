    },
    {
      "t": 28.811,
      "text": "月碎在了眉尖"
    },
    {
      "t": 33.691,
      "text": "梦也醉去樽前"
    },
    {
      "t": 38.771,
      "text": "再向明河中看一眼"
    },
    {
      "t": 43.811,
      "text": "看到迷离人间"
    },
    {
      "t": 49.471,
      "text": "姮娥横波眄，云母屏边，烛灯泪浅"
    },
    {
      "t": 54.751,
      "text": "鲤鱼引水仙，沧海明月，碧海青天"
    },
    {
      "t": 60.181,
      "text": "人向蓬山去，青鸟啼鹤怨"
    },
    {
      "t": 65.141,
      "text": "此生何未至，只留无题诗几篇？"
    },
    {
      "t": 70.141,
      "text": "难道 是隔雨帘悲绮筵"
    },
    {
      "t": 75.341,
      "text": "忘前事 睡在残荷声间？"
    },
    {
      "t": 81.031,
      "text": "是坐烛前 对空笺"
    },
    {
      "t": 85.981,
      "text": "遣怀时不忍用 最惘然的梦去填？"
    },
    {
      "t": 91.151,
      "text": "难道 是登高野临古原"
    },
    {
      "t": 96.251,
      "text": "借茫茫的夜远望天阙"
    },
    {
      "t": 102.031,
      "text": "平生事如雀过眼"
    },
    {
      "t": 107.311,
      "text": "不知何以言"
    },
    {
      "t": 125.451,
      "text": "画楼看宝焰，舞喧诗艳，剑山酒泉"
    },
    {
      "t": 130.521,
      "text": "歌哭声重叠，白骨茂陵，墨客梁园"
    },
    {
      "t": 135.801,
      "text": "长安多少檐，萧萧风雨间"
    },
    {
      "t": 141.201,
      "text": "多少人走过，只留下绝句几篇？"
    },
    {
      "t": 145.781,
      "text": "从来 是古人绝来者鲜"
    },
    {
      "t": 150.901,
      "text": "偶得自天地悠悠之间"
    },
    {
      "t": 156.581,
      "text": "是岁晚心怀亦远"
    },
    {
      "t": 161.751,
      "text": "便与当年群贤 终老于辋川蓝田"
    },
    {
      "t": 166.971,
      "text": "从来 是朱雀桥边少年"
    },
    {
      "t": 171.821,
      "text": "乱雨中吟哦大厦倾前"
    },
    {
      "t": 177.421,
      "text": "老骨恃笔如倚剑"
    },
    {
      "t": 182.741,
      "text": "力竭欲回天"
    },
    {
      "t": 190.111,
      "text": "就在 满眼朝风暮雨间"
    },
    {
      "t": 195.391,
      "text": "是谁仍淋漓挥毫不倦"
    },
    {
      "t": 200.741,
      "text": "似一生非要写完"
    },
    {
      "t": 206.021,
      "text": "永无绝的悲欢 和爱恨感怀伤别"
    },
    {
      "t": 211.231,
      "text": "千载 万龄后古碑残卷"
    },
    {
      "t": 216.101,
      "text": "旧迹都化作松雪云烟"
    },
    {
      "t": 221.761,
      "text": "唯有锦瑟一声弦"
    },
    {
      "t": 226.951,
      "text": "长喟天地间"
    }
  ]
