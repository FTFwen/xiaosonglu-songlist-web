      "text": "撒腿就要开蹘"
    },
    {
      "t": 55.95,
      "text": "转身偏又撞见隔壁家婉桃"
    },
    {
      "t": 58.59,
      "text": "算了作罢了"
    },
    {
      "t": 59.64,
      "text": "英雄不怕虎豹"
    },
    {
      "t": 61.26,
      "text": "我怎能为藤条折腰"
    },
    {
      "t": 64.59,
      "text": "我娘说四宝你瞧瞧"
    },
    {
      "t": 66.3,
      "text": "田野间半山腰"
    },
    {
      "t": 67.65,
      "text": "农人多辛劳"
    },
    {
      "t": 69.9,
      "text": "年年又岁岁复年年"
    },
    {
      "t": 71.61,
      "text": "官茶重赋税高"
    },
    {
      "t": 72.93,
      "text": "终究在所难逃"
    },
    {
      "t": 74.61,
      "text": "对门胖哥赵家小雨对我笑"
    },
    {
      "t": 76.98,
      "text": "笑我半点不懂干活却只顾着求饶"
    },
    {
      "t": 80.28,
      "text": "婉桃素手轻翘 指间茶菁掉"
    },
    {
      "t": 106.59,
      "text": "大把柴 填坑灶"
    },
    {
      "t": 107.91,
      "text": "锅里水正烧"
    },
    {
      "t": 109.02,
      "text": "沸水腾腾 茶棚外雾气缭缭"
    },
    {
      "t": 111.93,
      "text": "抹板凳 擦桌角"
    },
    {
      "t": 113.28,
      "text": "只等客人到"
    },
    {
      "t": 114.3,
      "text": "捧一摞碗 小心翼翼不乱摇"
    },
    {
      "t": 117.03,
      "text": "茶小二 屋外叫"
    },
    {
      "t": 118.62,
      "text": "出来招呼好"
    },
    {
      "t": 119.67,
      "text": "老妇枯槁 单影无靠 进来歇歇脚"
    },
    {
      "t": 122.31,
      "text": "俊小哥 去赶考"
    },
    {
      "t": 123.96,
      "text": "多送你一勺"
    },
    {
      "t": 124.89,
      "text": "钱不要题字做抵消"
    },
    {
      "t": 127.95,
      "text": "远处乱糟糟"
    },
    {
      "t": 128.91,
      "text": "恶霸又来路边闹"
    },
    {
      "t": 130.26,
      "text": "上次吃白食上上次欺大嫂"
    },
    {
      "t": 133.32,
      "text": "这次先说好"
    },
    {
      "t": 134.25,
      "text": "付账还是打欠条"
    },
    {
      "t": 135.63,
      "text": "恶霸大喝 冲上来把我衣领薅"
    },
    {
      "t": 138.6,
      "text": "你个小兔羔"
    },
    {
      "t": 139.65,
      "text": "虎头上敢拔毛"
    },
    {
      "t": 141.27,
      "text": "爷不稀罕你这僻壤穷山坳"
    },
    {
      "t": 143.97,
      "text": "客官向后靠"
    },
    {
      "t": 144.9,
      "text": "好汉不畏佬佬"
    },
    {
      "t": 146.58,
      "text": "我四宝定让他求饶"
    },
    {
      "t": 149.94,
      "text": "大黄在身后发出低声吼叫"
    },
    {
      "t": 152.28,
      "text": "只等着我吹响口哨"
    },
    {
      "t": 155.28,
      "text": "一瞬间如同宝剑出鞘"
    },
    {
      "t": 157.14,
      "text": "咬得他连连哀嚎四处奔逃"
    },
    {
      "t": 159.93,
      "text": "人生一路 总会遇到 拦路妖"
    },
    {
      "t": 162.48,
      "text": "纵天赋异禀也难以抵挡 世事难料"
    },
    {
      "t": 165.6,
      "text": "过茗园将一灵芽 收进荷包"
    },
    {
      "t": 171.24,
      "text": "傍晚店打烊我娘披起衣袍"
    },
    {
      "t": 173.64,
      "text": "在院中将新叶翻炒"
    },
    {
      "t": 176.61,
      "text": "一篮接着一篮倾倒"
    },
    {
      "t": 178.32,
      "text": "微火烘烤这玄味 羡煞春草"
    },
    {
      "t": 181.26,
      "text": "人就像茶 得受得了 高温熬"
    },
    {
      "t": 183.57,
      "text": "叶片从浮到沉由卷至舒 艰辛多少"
    },
    {
      "t": 186.63,
      "text": "采茶诗里一首歌 唱破春晓"
    }
  ]
}
