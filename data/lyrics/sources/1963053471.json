    {
      "t": 138.92,
      "text": "启程就无悔"
    },
    {
      "t": 142.09,
      "text": "你一路喜悲"
    },
    {
      "t": 144.28,
      "text": "又怎会无人了解体会"
    },
    {
      "t": 148.27,
      "text": "旅途未完 千山万水空白待绘"
    },
    {
      "t": 158.84,
      "text": "枯荣相随"
    },
    {
      "t": 165.43,
      "text": "泥泞步履踏碎泪泊"
    },
    {
      "t": 167.89,
      "text": "拥向光如抱薪赴火"
    },
    {
      "t": 171.05,
      "text": "妄想着永不分离的梦"
    },
    {
      "t": 178.05,
      "text": "幸福从非泡影"
    },
    {
      "t": 180.43,
      "text": "以笑容证明"
    },
    {
      "t": 183.5,
      "text": "交汇的光与影"
    },
    {
      "t": 185.73,
      "text": "答案落定覆上姓名"
    },
    {
      "t": 189.51,
      "text": "为了你唱下去"
    },
    {
      "t": 191.87,
      "text": "为你将希冀传递"
    },
    {
      "t": 195.34,
      "text": "歌声将你我紧系"
    },
    {
      "t": 200.25,
      "text": "最黯淡的一个"
    },
    {
      "t": 202.32,
      "text": "梦最为炽热"
    },
    {
      "t": 205.7,
      "text": "万千孤单焰火"
    },
    {
      "t": 207.84,
      "text": "让这虚构灵魂鲜活"
    },
    {
      "t": 211.19,
      "text": "至少在这一刻"
    },
    {
      "t": 214.38,
      "text": "热爱不问为何"
