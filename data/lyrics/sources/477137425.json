      "t": 0,
      "text": "风透过人潮渐渐停歇的下雨天"
    },
    {
      "t": 2.84,
      "text": "将平凡的故事翻到末页"
    },
    {
      "t": 5.39,
      "text": "并未留下浓重的墨点"
    },
    {
      "t": 8.25,
      "text": "在字里行间流连"
    },
    {
      "t": 10.44,
      "text": "最接近夜的灰褪去的那抹苍蓝"
    },
    {
      "t": 13.01,
      "text": "凝结成悲欢震颤伞面"
    },
    {
      "t": 15.72,
      "text": "究竟要千百次多强烈"
    },
    {
      "t": 18.13,
      "text": "才能激起方寸漪涟"
    },
    {
      "t": 33.03,
      "text": "空泛 谁的戏言"
    },
    {
      "t": 35.9,
      "text": "在某个夏日黄昏晕散"
    },
    {
      "t": 38.61,
      "text": "被鸣蝉 散播遥远"
    },
    {
      "t": 41,
      "text": "传达到你所在的明天"
    },
    {
      "t": 43.65,
      "text": "在明天 驻足无人的车站"
    },
    {
      "t": 45.96,
      "text": "久别的阳炎越过无尽的深蓝"
    },
    {
      "t": 49.49,
      "text": "越过每寸黑夜"
    },
    {
      "t": 50.94,
      "text": "与我重逢在梅雨季节"
    },
    {
      "t": 55.73,
      "text": "雨迹的蜿蜒 干涸的思念"
    },
    {
      "t": 58.64,
      "text": "腐朽的栏杆锈迹斑斑"
    },
    {
      "t": 61.28,
      "text": "一如从前而截然相反"
    },
    {
      "t": 63.62,
      "text": "仿佛两人曾经相携"
    },
    {
      "t": 66.29,
      "text": "余音轻颤 不协和和弦"
    },
    {
      "t": 68.69,
      "text": "孤独的今天仍让人如此疲惫怠倦"
    },
    {
      "t": 73.61,
      "text": "令这街道默然"
    },
    {
      "t": 78.68,
      "text": "城市从不缺机械冰冷之物陪伴"
    },
    {
      "t": 81.24,
      "text": "如0与1交织的贪婪"
    },
    {
      "t": 83.75,
      "text": "慢慢将这颗心染黑了"
    },
    {
      "t": 86.39,
      "text": "又让我如此迷恋"
    },
    {
      "t": 88.73,
      "text": "即使这种矛盾普遍地存于世间"
    },
    {
      "t": 91.31,
      "text": "麻木如我也感到赧然"
    },
    {
      "t": 93.84,
      "text": "不得不随波逐流的今天"
    },
    {
      "t": 96.44,
      "text": "渐渐对自我生厌"
    },
    {
      "t": 99.55,
      "text": "街灯将 这城市渲染如昼"
    },
    {
      "t": 101.66,
      "text": "但再相似的光明也没有理由"
    },
    {
      "t": 105.1,
      "text": "取代任何丑陋"
    },
    {
      "t": 106.58,
      "text": "却有些许温度的残留"
    },
    {
      "t": 111.26,
      "text": "泪痕的蜿蜒 枯竭的语言"
    },
    {
      "t": 114.1,
      "text": "夏日的余光隐匿不见"
    },
    {
      "t": 116.76,
      "text": "不似从前又渴望看见"
    },
    {
      "t": 119.01,
      "text": "泛黄却绮丽的画面"
    },
    {
      "t": 121.86,
      "text": "雨声潺潺 混杂着悲叹"
    },
    {
      "t": 124.25,
      "text": "谁人在无人问津的街角无声祈愿"
    },
    {
      "t": 129.05,
      "text": "让季节停止哽咽"
    },
    {
      "t": 134.61,
      "text": "将世界最后的空白刻印在斑驳心海"
    },
    {
      "t": 139.39,
      "text": "而我等蜉蝣只得抒发不足日的无奈"
    },
    {
      "t": 144.4,
      "text": "无名歌者哼唱着积雨云为之落泪的歌在人海"
    },
    {
      "t": 154.56,
      "text": "浅色墨点 排列的平凡"
    },
    {
      "t": 157.08,
      "text": "也高歌不止直至终焉"
    },
    {
      "t": 159.76,
      "text": "即使离别 千万次泫然"
    },
    {
      "t": 162.16,
      "text": "我仍不甘匍匐于此"
    },
    {
      "t": 164.88,
      "text": "越过黑夜后渐变的蓝"
    },
    {
      "t": 167.12,
      "text": "你脉搏中的熟悉温度"
    },
    {
      "t": 169.85,
      "text": "终与我重逢"
    },
    {
      "t": 172.12,
      "text": "在凉雨停歇的那天"
    }
  ]
