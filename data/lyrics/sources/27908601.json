  "lines": [
    {
      "t": 31.8,
      "text": "夜寂夜鸦起 夜息夜鸦寂"
    },
    {
      "t": 35.8,
      "text": "夜息 伴君起且为君着轻衣 辞去"
    },
    {
      "t": 40.6,
      "text": "不过朝夕 却 恍若三季"
    },
    {
      "t": 46.15,
      "text": "雪 纷飞杨柳岸"
    },
    {
      "t": 51.4,
      "text": "看 谁家纸鸢 遥盼"
    },
    {
      "t": 53.9,
      "text": "风 扶摇青云巅"
    },
    {
      "t": 57.9,
      "text": "君 何时再 还"
    },
    {
      "t": 61.3,
      "text": "盼到红霞漫斜阳醉天边"
    },
    {
      "t": 63.3,
      "text": "再 重拾羽衣轻点眉间"
    },
    {
      "t": 68.3,
      "text": "为君舞歌一曲纤云鹊桥仙"
    },
    {
      "t": 72.5,
      "text": "与君共醉樽前"
    },
    {
      "t": 76.5,
      "text": "今朝连夜雨飘摇落巫山"
    },
    {
      "t": 79.5,
      "text": "谁管他断了的红线"
    },
    {
      "t": 84.2,
      "text": "只恨那夜鸦声轻葬了缠绵"
    },
    {
      "t": 87.2,
      "text": "也葬了半世缘"
    },
    {
      "t": 106.9,
      "text": "夜寂夜鸦起 夜息夜鸦寂"
    },
    {
      "t": 110.9,
      "text": "夜息 孤影寂凭栏叹晚风急 别离"
    },
    {
      "t": 117.2,
      "text": "已过三季 却 恍若朝夕"
    },
    {
      "t": 122.27,
      "text": "燕 堂前雨喃喃"
    },
    {
      "t": 125.8,
      "text": "花 叶下缱绻 纸鸢"
    },
    {
      "t": 129.8,
      "text": "线 似断也未断"
    },
    {
      "t": 133.8,
      "text": "君 此生不 见"
    },
    {
      "t": 137.08,
      "text": "遥叹我不过歌舞青楼间"
    },
    {
      "t": 139.8,
      "text": "君 墨染弦风流过青衫"
    },
    {
      "t": 144.8,
      "text": "世流言 事难全 夜夜共婵娟"
    },
    {
      "t": 147.8,
      "text": "夜夜夜鸦阑珊"
    },
    {
      "t": 151.8,
      "text": "君尝言 执长剑 灭杀鸦三千"
    },
    {
      "t": 154.8,
      "text": "春花共秋月与我踏遍"
    },
    {
      "t": 159.8,
      "text": "雨声乱 玉笙寒 挑灯又翻看"
    },
    {
      "t": 162.8,
      "text": "君予我的画卷"
    },
    {
      "t": 182.7,
      "text": "帆 彼岸携手流年 渐行渐远"
    },
    {
      "t": 190.7,
      "text": "我 焚琴断弦 只身游遍 山河万千"
    },
    {
      "t": 197.7,
      "text": "笑 不似彼时孤寒 他乡夜暖"
    },
    {
      "t": 205.7,
      "text": "忽 风起鸦声渐渐 吹落谁的泪眼"
    }
  ]
}
