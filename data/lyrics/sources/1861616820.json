      "t": 17.59,
      "text": "燕去时 红豆满枝"
    },
    {
      "t": 21.52,
      "text": "远游人 莫问归期"
    },
    {
      "t": 25.02,
      "text": "谁独守潇湘水碧"
    },
    {
      "t": 28.22,
      "text": "不知今夕何夕"
    },
    {
      "t": 31.86,
      "text": "燕回时 良人无迹"
    },
    {
      "t": 35.7,
      "text": "应有意 此去别离"
    },
    {
      "t": 39.25,
      "text": "不愿长情无所寄"
    },
    {
      "t": 41.91,
      "text": "远行寻寻觅觅 千里"
    },
    {
      "t": 46.42,
      "text": "他挥毫泼墨落笔"
    },
    {
      "t": 49.58,
      "text": "她舞袖梦里佳期"
    },
    {
      "t": 53.05,
      "text": "戏中情 戏中意"
    },
    {
      "t": 54.51,
      "text": "陌路人相逢"
    },
    {
      "t": 58.47,
      "text": "在花天锦地"
    },
    {
      "t": 62.3,
      "text": "她唱着 他乡遇故知"
    },
    {
      "t": 66.08,
      "text": "一步一句是相思"
    },
    {
      "t": 69.53,
      "text": "台下人 金榜正题名"
    },
    {
      "t": 73.08,
      "text": "不曾认 台上旧相识"
    },
    {
      "t": 76.49,
      "text": "他说着 洞房花烛时"
    },
    {
