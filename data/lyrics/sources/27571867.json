    },
    {
      "t": 1,
      "text": "作曲 : 河图"
    },
    {
      "t": 39.2,
      "text": "刀戟声共丝竹沙哑"
    },
    {
      "t": 41.1,
      "text": "谁带你看城外厮杀"
    },
    {
      "t": 42.97,
      "text": "七重纱衣 血溅了白纱"
    },
    {
      "t": 45.79,
      "text": "兵临城下六军不发"
    },
    {
      "t": 49.44,
      "text": "谁知再见已是 生死无话"
    },
    {
      "t": 54.05,
      "text": "当时缠过红线千匝"
    },
    {
      "t": 55.72,
      "text": "一念之差作为人嫁"
    },
    {
      "t": 57.7,
      "text": "那道伤疤 谁的旧伤疤"
    },
    {
      "t": 60.46,
      "text": "还能不动声色饮茶"
    },
    {
      "t": 63.92,
      "text": "踏碎这一场 盛世烟花"
    },
    {
      "t": 67.2,
      "text": "血染江山的画"
    },
    {
      "t": 69.56,
      "text": "怎敌你眉间 一点朱砂"
    },
    {
      "t": 74.13,
      "text": "覆了天下也罢"
    },
    {
      "t": 76.83,
      "text": "始终不过 一场繁华"
    },
    {
      "t": 81.63,
      "text": "碧血染就桃花"
    },
    {
      "t": 84.41,
      "text": "只想再见 你泪如雨下"
    },
    {
      "t": 89.59,
      "text": "听刀剑喑哑"
    },
    {
      "t": 91.65,
      "text": "高楼奄奄一息 倾塌"
    },
    {
      "t": 97.85,
      "text": "是说一生命犯桃花"
    },
    {
      "t": 99.6,
      "text": "谁为你算的那一卦"
    },
    {
      "t": 101.58,
      "text": "最是无瑕 风流不假"
    },
    {
      "t": 104.36,
      "text": "画楼西畔反弹琵琶"
    },
    {
      "t": 107.87,
      "text": "暖风处处 谁心猿意马"
    },
    {
      "t": 112.43,
      "text": "色授魂与颠倒容华"
    },
    {
      "t": 114.28,
      "text": "兀自不肯相对照蜡"
    },
    {
      "t": 116.07,
      "text": "说爱折花 不爱青梅竹马"
    },
    {
      "t": 118.96,
      "text": "到头来算的那一卦"
    },
    {
      "t": 122.46,
      "text": "终是为你 覆了天下"
    },
    {
      "t": 125.7,
      "text": "明月照亮天涯"
    },
    {
      "t": 128.1,
      "text": "最后谁又 得到了蒹葭"
    },
    {
      "t": 132.9,
      "text": "江山嘶鸣战马"
    },
    {
      "t": 135.56,
      "text": "怀抱中那 寂静的喧哗"
    },
    {
      "t": 140.24,
      "text": "风过天地肃杀"
    },
    {
      "t": 142.95,
      "text": "容华谢后 君临天下"
    },
    {
      "t": 148.05,
      "text": "登上九重宝塔"
    },
    {
      "t": 150.07,
      "text": "看一夜 流星飒沓"
    },
    {
      "t": 184.13,
      "text": "回到那一刹那"
    },
    {
      "t": 186.49,
      "text": "岁月无声也让人害怕"
    },
    {
      "t": 191.29,
      "text": "枯藤长出枝桠"
    },
    {
      "t": 193.86,
      "text": "原来时光已翩然轻擦"
    },
    {
      "t": 198.79,
      "text": "梦中楼上月下"
    },
    {
      "t": 201.11,
      "text": "站着眉目依旧的你啊"
    },
    {
      "t": 206.6,
      "text": "拂去衣上雪花"
    },
    {
      "t": 208.69,
      "text": "并肩看 天地浩大"
    },
