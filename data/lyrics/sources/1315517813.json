    {
      "t": 58.086,
      "text": "归于寂静 沉入黑暗"
    },
    {
      "t": 65.414,
      "text": "仅存那 深红的花火"
    },
    {
      "t": 72.355,
      "text": "抚慰还未 到来的明日"
    },
    {
      "t": 79.148,
      "text": "请安宁入梦吧"
