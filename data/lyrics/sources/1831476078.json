    {
      "t": 55.71,
      "text": "今夜若欠清光满堂"
    },
    {
      "t": 58.18,
      "text": "蘸笔天河绘万古生香"
    },
    {
      "t": 61.45,
      "text": "史笔滔滔烟霞绣像"
    },
    {
      "t": 64,
      "text": "就中拈来玲珑十二章"
    },
    {
      "t": 67.4,
      "text": "吹开汗青淋漓苍茫"
    },
    {
      "t": 69.9,
      "text": "明辨残稿谁秋水一双"
    },
    {
      "t": 73.34,
      "text": "书阁深处篆隶流芳"
    },
    {
      "t": 75.56,
      "text": "断简遗篇挥毫续兴亡"
    },
    {
      "t": 78.58,
      "text": "谁 白草胡笳烽燧长"
    },
    {
      "t": 81.49,
      "text": "将半生哀毁以诗情抵挡"
    },
    {
      "t": 84.38,
      "text": "断弦含泪更张"
    },
    {
      "t": 87.63,
      "text": "最高贵流浪"
    },
    {
      "t": 89.66,
      "text": "隔几世 玉楼试才歌咏琳琅"
    },
    {
      "t": 93.42,
      "text": "冠绝了乌衣巷"
    },
    {
      "t": 96.23,
      "text": "谁一语风絮荡荡 摹尽落雪茫茫"
    },
    {
      "t": 101.2,
      "text": "谁万里关山暂忘女儿模样 家与国都担当"
    },
    {
      "t": 107.78,
      "text": "再亲手摘下 黄河落日黑山飞霜 铁甲揩亮"
    },
    {
      "t": 114.1,
      "text": "舍旧时云裳"
    },
    {
      "t": 129.02,
      "text": "乱世丹心碧血满腔"
    },
    {
      "t": 131.22,
      "text": "灵思千转一意辅隋杨"
    },
    {
      "t": 134.78,
      "text": "河山纷裂终须入掌"
    },
    {
      "t": 137.06,
      "text": "百万明珠抬手赐名将"
    },
    {
      "t": 140.65,
      "text": "逸兴遄飞催花一场"
    },
    {
      "t": 143.04,
      "text": "犹记看朱成碧添惆怅"
    },
    {
      "t": 146.44,
      "text": "凰音一绽惊肃朝纲"
    },
    {
      "t": 148.74,
      "text": "无字空碑自不负倔强"
    },
    {
      "t": 151.79,
      "text": "谁 一身风雅奉君王"
    },
    {
      "t": 154.62,
      "text": "持素心清明秤天下才郎"
    },
    {
      "t": 157.52,
      "text": "遇合锦绣黄粱"
    },
    {
      "t": 160.63,
      "text": "纷纭中静赏"
    },
    {
      "t": 162.81,
      "text": "后来有 一生明旷漱玉噙香"
    },
    {
      "t": 166.56,
      "text": "乌江旁歌霸王"
    },
    {
      "t": 169.33,
      "text": "结一代清雅无双 举世衣冠齐望"
    },
    {
      "t": 174.45,
      "text": "而燕燕于飞怎甘随波低昂 睥睨燕云月上"
    },
    {
      "t": 181,
      "text": "谁马踏桃花 画角长吟金鼓铿锵 寸土不让"
    },
    {
      "t": 187.3,
      "text": "万军一剑挡"
    },
    {
      "t": 213.78,
      "text": "煌煌千载辉光"
    },
    {
      "t": 217.85,
      "text": "古今盛筵长"
    },
    {
      "t": 222.36,
      "text": "何幸有你登场"
    },
    {
      "t": 226.67,
      "text": "共举霞觞"
    },
    {
      "t": 230.77,
      "text": "谁血作胭脂 枪起夭矫龙翔 翠袖虎符封疆"
    },
    {
      "t": 237.38,
      "text": "谁又定两朝风波 掌三世的荣光"
    },
    {
      "t": 242.45,
      "text": "今夜我为你轻叙巾帼芬芳 浩歌一曲传香"
    },
    {
      "t": 248.92,
      "text": "唱不完跌宕 明媚刚强 百代秾华千秋榜样"
    },
    {
      "t": 255.26,
      "text": "行经故梦今又来访"
    },
    {
      "t": 258.15,
      "text": "天高海阔盛世飞扬"
    },
    {
      "t": 261.18,
      "text": "再谱十万章"
    },
    {
      "t": 288.7,
      "text": "调校 : Creuzer"
    }
  ]
