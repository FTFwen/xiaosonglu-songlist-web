    },
    {
      "t": 7.55,
      "text": "穿旧巷 过回廊"
    },
    {
      "t": 10.75,
      "text": "夜风透晚墙"
    },
    {
      "t": 14.2,
      "text": "褪戎装 着素裳"
    },
    {
      "t": 17.55,
      "text": "归来已秋凉"
    },
    {
      "t": 20.35,
      "text": "衣袖错勘身量遗落月白露光"
    },
    {
      "t": 26.95,
      "text": "原是天地冥冥斗转掀翻过往"
    },
    {
      "t": 34.81,
      "text": "芙蓉帐 桂花酿"
    },
    {
      "t": 37.8,
      "text": "倾身黄梨傍"
    },
    {
      "t": 41.21,
      "text": "旌旗晃 战歌亡"
    },
    {
      "t": 44.61,
      "text": "枕戈黄沙烫"
    },
    {
      "t": 47.46,
      "text": "该怎样赎回殉节的一片瘠荒"
    },
    {
      "t": 54.06,
      "text": "还如何拾起你眼中破碎琳琅"
    },
    {
      "t": 59.96,
      "text": "绛烛残泪灯影幢幢"
    },
    {
      "t": 64.51,
      "text": "念卿若狂"
    },
    {
      "t": 67.81,
      "text": "心思成网"
    },
    {
      "t": 70.41,
      "text": "移步轻颤忽而僵"
    },
    {
      "t": 74.72,
      "text": "前尘散尽天道昭彰幽魂荡"
    },
    {
      "t": 82.12,
      "text": "留你茕茕伶俜不忍思量"
    },
    {
      "t": 87.12,
      "text": "远山娥黛明眸善睐"
    },
    {
      "t": 91.77,
      "text": "月华成妆"
    },
    {
      "t": 95.02,
      "text": "衣衫轻扬"
    },
    {
      "t": 97.47,
      "text": "自今一别无所妄"
    },
    {
      "t": 101.87,
      "text": "只愿清虚宫外摇响白玉铃铛"
    },
    {
      "t": 109.27,
      "text": "伴你岁岁 安康"
    },
    {
      "t": 114.62,
      "text": "——————"
    },
    {
      "t": 122.63,
      "text": "荷灯放 石桥旁"
    },
    {
      "t": 126.13,
      "text": "烛火照眸光"
    },
    {
      "t": 129.63,
      "text": "江水淌 向何方"
    },
    {
      "t": 132.98,
      "text": "绵绪万里长"
    },
    {
      "t": 135.78,
      "text": "此去经月转瞬之间芙蓉飘香"
    },
    {
      "t": 142.43,
      "text": "君可知否孑然一身难成红妆"
    },
    {
      "t": 150.28,
      "text": "踏落黄 望梓桑"
    },
    {
      "t": 153.43,
      "text": "鹧鸪浅山藏"
    },
    {
      "t": 156.83,
      "text": "各一方 君莫忘"
    },
    {
      "t": 160.18,
      "text": "绳结挂心上"
    },
    {
      "t": 162.99,
      "text": "天寒难捱风吹雪落荒漠边疆"
    },
    {
      "t": 169.54,
      "text": "应是捷报纵马而来良人归乡"
    },
    {
      "t": 175.49,
      "text": "陡然心凉蜉蝣流浪"
    },
    {
      "t": 180.09,
      "text": "朝生暮亡"
    },
    {
      "t": 183.34,
      "text": "雾霭苍苍"
    },
    {
      "t": 185.94,
      "text": "寻不见归期有望"
    },
    {
      "t": 190.14,
      "text": "千秋万岁叩八荒莫敢违抗"
    },
    {
      "t": 197.95,
      "text": "只盼君脱身于刀枪熙攘"
    },
    {
      "t": 202.6,
      "text": "转身回望谁在吟唱"
    },
    {
      "t": 207.2,
      "text": "“陟彼高冈"
    },
    {
      "t": 210.4,
      "text": "我马玄黄”"
    },
    {
      "t": 213.15,
      "text": "终不见人影成双"
    },
    {
      "t": 217.3,
      "text": "秋水摇曳荷灯蜿蜒伸向远方"
    },
    {
      "t": 224.8,
      "text": "独留月光 微凉"
    }
  ]
