  "lines": [
    {
      "t": 44.72,
      "text": "薄雾初凝霜 寒铁映酧光"
    },
    {
      "t": 48.09,
      "text": "着我新戎装 剑指边疆"
    },
    {
      "t": 51.35,
      "text": "浅雪敬短裳 落日避寒枪"
    },
    {
      "t": 54.66,
      "text": "待我功成后 冠翎归乡"
    },
    {
      "t": 58.09,
      "text": "秋风划过落叶响"
    },
    {
      "t": 61.2,
      "text": "目送鸿雁西南望"
    },
    {
      "t": 64.69,
      "text": "又是一年的霜降"
    },
    {
      "t": 68.32,
      "text": "将士何不羡鸳鸯"
    },
    {
      "t": 71.57,
      "text": "战鼓声阵阵入沙场"
    },
    {
      "t": 74.79,
      "text": "箭矢雨弥闭了天光"
    },
    {
      "t": 77.97,
      "text": "舞起枪断绝了念想"
    },
    {
      "t": 81.64,
      "text": "或胜利或者是死亡"
    },
    {
      "t": 85.16,
      "text": "逆风处请君醉沙场"
    },
    {
      "t": 88.65,
      "text": "用鲜血涂满旧戎装"
    },
    {
      "t": 92.07,
      "text": "不要管添多少新伤"
    },
    {
      "t": 95.44,
      "text": "乱军中以血拭锋芒"
    },
    {
      "t": 128.47,
      "text": "双手捧著野菜汤"
    },
    {
      "t": 131.45,
      "text": "终於熬过了青黄"
    },
    {
      "t": 134.78,
      "text": "又是一年的霜降"
    },
    {
      "t": 138.23,
      "text": "缘木娘你可安康"
    },
    {
      "t": 141.56,
      "text": "恍然 梦中尤记 那年那月 你我初相遇"
    },
    {
      "t": 144.84,
      "text": "依稀 夜莺初啼 歌舞将息 共醉华年里"
    },
    {
      "t": 148.29,
      "text": "请你 不要记起 角落里不 经意的荼蘼"
    },
    {
      "t": 151.65,
      "text": "等我 大捷之后 与你再续 这一世夫妻"
    },
    {
      "t": 155.14,
      "text": "厮杀声阵阵入军帐"
    },
    {
      "t": 158.43,
      "text": "飞火雨弥闭了月光"
    },
    {
      "t": 161.96,
      "text": "舞起枪看不透希望"
    },
    {
      "t": 165.14,
      "text": "用双眼直面着死亡"
    },
    {
      "t": 168.74,
      "text": "任新刃撕开了旧伤"
    },
    {
      "t": 172.13,
      "text": "任鲜血浸透旧戎装"
    },
    {
      "t": 175.65,
      "text": "恨长枪消逝了锋芒"
    },
    {
      "t": 178.86,
      "text": "愿我魂回到你身旁"
    }
