    {
      "t": 28.48,
      "text": "匆匆那年我们"
    },
    {
      "t": 29.85,
      "text": "究竟说了几遍"
    },
    {
      "t": 31.21,
      "text": "再见之后再拖延"
    },
    {
      "t": 33.91,
      "text": "可惜谁又没有"
    },
    {
      "t": 35.38,
      "text": "爱过不是一场"
    },
    {
      "t": 36.71,
      "text": "七情上面的雄辩"
    },
    {
      "t": 39.65,
      "text": "匆匆那年我们"
    },
    {
      "t": 40.97,
      "text": "一时匆忙撂下"
    },
    {
      "t": 42.34,
      "text": "难以承受的诺言"
    },
    {
      "t": 45.24,
      "text": "只有等别人兑现"
    },
    {
      "t": 50.96,
      "text": "不怪那吻痕还"
    },
    {
      "t": 53.5,
      "text": "没积累成茧"
    },
    {
      "t": 56.39,
      "text": "拥抱着冬眠也没能"
    },
    {
      "t": 59.73,
      "text": "羽化再成仙"
    },
    {
      "t": 62.12,
      "text": "不怪这一段情"
    },
    {
      "t": 64.87,
      "text": "没空反复再排练"
    },
    {
      "t": 67.71,
      "text": "是岁月宽容恩赐"
    },
    {
      "t": 71.87,
      "text": "反悔的时间"
    },
    {
      "t": 78.73,
      "text": "如果再见不能红着眼"
    },
    {
      "t": 81.62,
      "text": "是否还能红着脸"
    },
    {
      "t": 84.64,
      "text": "就像那年匆促"
    },
    {
      "t": 85.98,
      "text": "刻下永远一起"
    },
    {
      "t": 87.38,
      "text": "那样美丽的谣言"
    },
    {
      "t": 89.87,
      "text": "如果过去还值得眷恋"
    },
    {
      "t": 92.85,
      "text": "别太快冰释前嫌"
    },
    {
      "t": 95.8,
      "text": "谁甘心就这样"
    },
    {
      "t": 98.54,
      "text": "彼此无挂也无牵"
    },
    {
      "t": 101.47,
      "text": "我们要互相亏欠"
    },
    {
      "t": 106.97,
      "text": "要不然凭何怀缅"
    },
    {
      "t": 118.58,
      "text": "匆匆那年我们"
    },
    {
      "t": 119.8,
      "text": "见过太少世面"
    },
    {
      "t": 121.12,
      "text": "只爱看同一张脸"
    },
    {
      "t": 124.02,
      "text": "那么莫名其妙"
    },
    {
      "t": 125.38,
      "text": "那么讨人欢喜"
    },
    {
      "t": 126.8,
      "text": "闹起来又太讨厌"
    },
    {
      "t": 129.59,
      "text": "相爱那年活该"
    },
    {
      "t": 130.96,
      "text": "匆匆因为我们"
    },
    {
      "t": 132.38,
      "text": "不懂顽固的诺言"
    },
    {
      "t": 135.17,
      "text": "只是分手的前言"
    },
    {
      "t": 140.79,
      "text": "不怪那天太冷"
    },
    {
      "t": 143.47,
      "text": "泪滴水成冰"
    },
    {
      "t": 146.35,
      "text": "春风也一样没"
    },
    {
      "t": 149.14,
      "text": "吹进凝固的照片"
    },
    {
      "t": 151.99,
      "text": "不怪每一个人"
    },
    {
      "t": 154.67,
      "text": "没能完整爱一遍"
    },
    {
      "t": 157.57,
      "text": "是岁月善意落下"
    },
    {
