      "text": "作曲 : Soda纯白"
    },
    {
      "t": 47.375,
      "text": "微露点滴 沾衿落袖"
    },
    {
      "t": 52.814,
      "text": "丽日绰约 轻解莲舟"
    },
    {
      "t": 58.385,
      "text": "蒹葭荣茂 燕雀啁啾"
    },
    {
      "t": 64.22,
      "text": "白石溪畔 斜阳逐流"
    },
    {
      "t": 69.284,
      "text": "可嫌金风玉露 兼程久"
    },
    {
      "t": 72.356,
      "text": "灵犀心念 便相谋"
    },
    {
      "t": 75.154,
      "text": "前路崎岖躞蹀攀援 亦同守"
    },
    {
      "t": 80.285,
      "text": "共你百年暮昏 到白昼"
    },
    {
      "t": 83.636,
      "text": "依山临水 景看旧"
    },
    {
      "t": 86.34,
      "text": "而你美胜山水万筹 尽入一人眸"
    },
    {
      "t": 93.4,
      "text": "琴瑟愿与 共沐春秋"
    },
    {
      "t": 98.897,
      "text": "滢溪潺潺 炊烟悠悠"
    },
    {
      "t": 104.483,
      "text": "敢请东风 玉成双偶"
    },
    {
      "t": 109.986,
      "text": "遥递佳信 知否知否"
    },
    {
      "t": 115.648,
      "text": "为理云鬓 为簪银钩"
    },
    {
      "t": 121.316,
      "text": "明月可鉴 情深亦寿"
    },
    {
      "t": 126.873,
      "text": "此生相依 人间白首"
    },
    {
      "t": 132.387,
      "text": "千金不易 清茶淡粥"
    },
    {
      "t": 161.684,
      "text": "前缘既断 便再无求"
    },
    {
      "t": 167.274,
      "text": "云泥之异 难越鸿沟"
    },
    {
      "t": 172.899,
      "text": "相思不扫 久积弥厚"
    },
    {
      "t": 178.399,
      "text": "他年君归 我葬南丘"
    },
    {
      "t": 183.762,
      "text": "逢春枯木忽生 花飞柳"
    },
    {
      "t": 186.802,
      "text": "纷纷绵绵 结作愁"
    },
    {
      "t": 189.631,
      "text": "随风四散却又轻易 染眉头"
    },
    {
      "t": 194.746,
      "text": "当时一双鸳鸯 入深藕"
    },
    {
      "t": 197.906,
      "text": "荷香绕水 乐同游"
    },
    {
      "t": 200.826,
      "text": "月下花前本来无酒 对看竟忘忧"
    },
    {
      "t": 207.858,
      "text": "何年何夕 两相执手"
    },
    {
      "t": 213.241,
      "text": "蚀骨相思 风侵寒透"
    },
    {
      "t": 218.945,
      "text": "仙人近侧 怕倚小楼"
    },
    {
      "t": 224.477,
      "text": "金缕为笼 歌乐成囚"
    },
    {
      "t": 229.98,
      "text": "凉夜凄长 应怨更漏"
    },
    {
      "t": 235.545,
      "text": "数得千枚 零落红豆"
    },
    {
      "t": 241.264,
      "text": "遗君一心 一心怎收"
    },
    {
      "t": 246.679,
      "text": "杳渺音绝 余我孤奏"
    },
    {
      "t": 252.493,
      "text": "何年何夕 共沐春秋"
    },
    {
      "t": 257.975,
      "text": "银汉邈邈 炊烟悠悠"
    },
    {
      "t": 263.513,
      "text": "敢请东风 小住暂留"
    },
    {
      "t": 269.186,
      "text": "托书天地 安否安否"
    },
    {
      "t": 274.65,
      "text": "尘心如练 长悬银钩"
    },
    {
      "t": 280.411,
      "text": "鱼雁不闻 斯人难候"
    },
    {
      "t": 285.934,
      "text": "九霄一曲 人间白首"
    },
    {
      "t": 291.442,
      "text": "隔世相问 忆否忆否"
    }
  ]
